<Window x:Class="NewKewi.App.JobDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NewKewi.App"
        Title="รายละเอียดงาน" Height="520" Width="660" MinHeight="420" MinWidth="560"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBg}"
        FontFamily="Segoe UI, Leelawadee UI">

    <Window.Resources>
        <local:ByteSizeConverter x:Key="Size" />
        <local:SpeedConverter x:Key="Speed" />
        <local:EtaConverter x:Key="Eta" />
        <local:StatusTextConverter x:Key="StatusText" />

        <Style x:Key="FactLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextDim}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,10,6" />
        </Style>
        <Style x:Key="FactValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- หัวเรื่อง -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="StatusLine" FontSize="12" Foreground="{StaticResource TextDim}"
                       Margin="0,3,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <!-- แถบรวม -->
        <Border Grid.Row="1" Background="{StaticResource PanelBg}" CornerRadius="6"
                BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="12" Margin="0,0,0,12">
            <StackPanel>
                <Grid>
                    <ProgressBar x:Name="OverallBar" Height="20" Minimum="0" Maximum="100"
                                 Foreground="{StaticResource Accent}"
                                 Background="{StaticResource AccentDim}" BorderThickness="0" />
                    <TextBlock x:Name="OverallText" FontSize="11" HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Grid>

                <!-- แถบแบ่งชิ้นส่วนของ HLS · ซ่อนไว้ถ้าไม่ใช่ playlist -->
                <StackPanel x:Name="FragmentPanel" Margin="0,10,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="FragmentLabel" Style="{StaticResource FactLabel}" Margin="0,0,0,4" />
                    <ItemsControl x:Name="SegmentStrip" Height="12">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,1,0" CornerRadius="1" Background="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ตัวเลข -->
        <Border Grid.Row="2" Background="{StaticResource PanelBg}" CornerRadius="6"
                BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="12" Margin="0,0,0,12">
            <UniformGrid Columns="4">
                <StackPanel>
                    <TextBlock Text="ขนาด" Style="{StaticResource FactLabel}" />
                    <TextBlock x:Name="SizeText" FontSize="15" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="โหลดแล้ว" Style="{StaticResource FactLabel}" />
                    <TextBlock x:Name="DoneText" FontSize="15" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="ความเร็ว" Style="{StaticResource FactLabel}" />
                    <TextBlock x:Name="SpeedText" FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource Accent}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="เหลืออีก" Style="{StaticResource FactLabel}" />
                    <TextBlock x:Name="EtaText" FontSize="15" FontWeight="SemiBold" />
                </StackPanel>
            </UniformGrid>
        </Border>

        <!-- รายละเอียด -->
        <Border Grid.Row="3" Background="{StaticResource PanelBg}" CornerRadius="6"
                BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="12">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="ลิงก์ต้นทาง" Style="{StaticResource FactLabel}" />
                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="SourceUrlText" Style="{StaticResource FactValue}" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="ลิงก์สตรีม" Style="{StaticResource FactLabel}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="StreamUrlText" Style="{StaticResource FactValue}" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="ชนิด" Style="{StaticResource FactLabel}" />
                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="KindText" Style="{StaticResource FactValue}" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="config ที่ใช้" Style="{StaticResource FactLabel}" />
                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="ModuleText" Style="{StaticResource FactValue}" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="ช่องโหลด" Style="{StaticResource FactLabel}" />
                    <TextBlock Grid.Row="4" Grid.Column="1" x:Name="ChannelText" Style="{StaticResource FactValue}"
                               TextWrapping="Wrap" />

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="ปลายทาง" Style="{StaticResource FactLabel}" />
                    <TextBlock Grid.Row="5" Grid.Column="1" x:Name="OutputText" Style="{StaticResource FactValue}"
                               TextWrapping="Wrap" />

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="ใช้เวลาไป" Style="{StaticResource FactLabel}" />
                    <TextBlock Grid.Row="6" Grid.Column="1" x:Name="ElapsedText" Style="{StaticResource FactValue}" />

                    <TextBlock Grid.Row="7" Grid.Column="0" Text="หมายเหตุ" Style="{StaticResource FactLabel}" />
                    <TextBlock Grid.Row="7" Grid.Column="1" x:Name="NoteText" Style="{StaticResource FactValue}"
                               Foreground="{StaticResource Danger}" TextWrapping="Wrap" />
                </Grid>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="เปิดโฟลเดอร์" Width="110" Height="30" Margin="0,0,8,0" Click="OnOpenFolder" />
            <Button Content="ปิด" Width="90" Height="30" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
