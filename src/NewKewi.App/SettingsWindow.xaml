<Window x:Class="NewKewi.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ตั้งค่า" Height="600" Width="620"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBg}"
        FontFamily="Segoe UI, Leelawadee UI">

    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="Head">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,14,0,6" />
        </Style>
        <Style TargetType="TextBlock" x:Key="Hint">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource TextDim}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,10,0">

                <TextBlock Text="การโหลด" Style="{StaticResource Head}" Margin="0,0,0,6" />

                <TextBlock Text="โฟลเดอร์ปลายทาง" />
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" x:Name="DirBox" Padding="5" />
                    <Button Grid.Column="1" Content="เลือก…" Width="70" Margin="6,0,0,0"
                            Click="OnPickFolder" />
                </Grid>

                <TextBlock Text="โหลดกี่ลิงก์พร้อมกัน" Margin="0,12,0,4" />
                <TextBox x:Name="ParallelBox" Width="80" HorizontalAlignment="Left" Padding="5" />
                <TextBlock Style="{StaticResource Hint}" Text="1–16" />

                <TextBlock Text="หนึ่งลิงก์แตกเป็นกี่ช่อง" Margin="0,12,0,4" />
                <TextBox x:Name="ChannelBox" Width="80" HorizontalAlignment="Left" Padding="5" />
                <TextBlock Style="{StaticResource Hint}"
                           Text="1–32 · playlist ใช้เป็นจำนวนชิ้นส่วนที่โหลดพร้อมกัน ส่วนไฟล์เดี่ยวใช้เป็นจำนวนการเชื่อมต่อของ aria2c" />

                <TextBlock Text="ลองชิ้นส่วนซ้ำกี่ครั้ง" Margin="0,12,0,4" />
                <TextBox x:Name="FragRetryBox" Width="80" HorizontalAlignment="Left" Padding="5" />
                <TextBlock Style="{StaticResource Hint}"
                           Text="0–20 · นี่คือการลองชิ้นส่วนซ้ำภายในความพยายามเดียวกัน ไม่ใช่การเริ่มงานใหม่ · งานที่ล้มเหลวจะไม่ถูกเริ่มใหม่เองไม่ว่าตั้งค่านี้เท่าไร" />

                <CheckBox x:Name="SkipExistingBox" Content="มีไฟล์ชื่อเดียวกันอยู่แล้วให้ข้าม" />

                <TextBlock Text="ไฟล์ที่ได้" Style="{StaticResource Head}" />
                <CheckBox x:Name="AlwaysMp4Box" Content="บังคับให้เป็น .mp4 เสมอ" />
                <CheckBox x:Name="ReencodeBox" Content="ถ้าเปลี่ยนกล่องเฉยๆ ไม่ได้ ยอมให้แปลงใหม่" />
                <TextBlock Style="{StaticResource Hint}"
                           Text="ไม่มีการแปลงเป็น H.265 ทุกกรณี · ของที่เป็น hevc อยู่แล้วจะถูก copy ไว้ตามเดิม" />

                <TextBlock Text="เบราว์เซอร์และด่านกันบอท" Style="{StaticResource Head}" />
                <CheckBox x:Name="InteractiveBox"
                          Content="เปิดหน้าต่างให้ฉันกดผ่านด่านกันบอทเองเมื่อจำเป็น" />
                <TextBlock Style="{StaticResource Hint}"
                           Text="ปิดไว้ถ้าปล่อยแอปโหลดทิ้งไว้โดยไม่มีคนเฝ้า จะได้ไม่มีหน้าต่างค้างรอ" />

                <TextBlock Text="รอให้กดผ่านนานสุด (วินาที)" Margin="0,12,0,4" />
                <TextBox x:Name="BotWaitBox" Width="80" HorizontalAlignment="Left" Padding="5" />

                <TextBlock Text="โฟลเดอร์ส่วนขยายกันโฆษณา" Margin="0,12,0,4" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" x:Name="AdBlockBox" Padding="5" />
                    <Button Grid.Column="1" Content="เลือก…" Width="70" Margin="6,0,0,0"
                            Click="OnPickExtension" />
                </Grid>
                <TextBlock Style="{StaticResource Hint}"
                           Text="ว่างไว้ = ไม่โหลดส่วนขยาย · ส่วนขยายช่วยให้หน้าเว็บที่เต็มไปด้วย popup แกะลิงก์ได้สะอาดกว่า" />

                <TextBlock Text="ความเป็นส่วนตัว" Style="{StaticResource Head}" />
                <TextBlock Style="{StaticResource Hint}"
                           Text="แอปใช้ cookie ของตัวเองเท่านั้น ไม่เคยอ่าน cookie ของเบราว์เซอร์ที่คุณใช้อยู่" />
                <Button Content="ล้าง cookie และ profile ของแอป" Width="240" Height="30"
                        HorizontalAlignment="Left" Margin="0,8,0,0" Click="OnClearCookies" />

                <CheckBox x:Name="AutoUploadBox"
                          Content="ส่ง log ของเว็บที่โหลดไม่ได้ขึ้น GitHub อัตโนมัติ" Margin="0,12,0,0" />
                <TextBlock Style="{StaticResource Hint}"
                           Text="ปิดไว้ = ถามก่อนทุกครั้ง · log มีชื่อเว็บที่คุณเข้า จึงไม่ส่งเองโดยไม่ถาม (ยังทำไม่เสร็จ อยู่ในเฟส 7)" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="ยกเลิก" Width="90" Height="30" Margin="0,0,8,0" IsCancel="True" />
            <Button Content="บันทึก" Width="100" Height="30" IsDefault="True" Click="OnSave"
                    Background="{StaticResource Accent}" Foreground="White" BorderThickness="0" />
        </StackPanel>
    </Grid>
</Window>
