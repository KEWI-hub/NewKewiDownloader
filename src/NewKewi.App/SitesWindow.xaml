<Window x:Class="NewKewi.App.SitesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="เว็บที่รองรับ" Height="520" Width="700"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBg}"
        FontFamily="Segoe UI, Leelawadee UI">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="SummaryText" Margin="0,0,0,8"
                   Foreground="{StaticResource TextDim}" TextWrapping="Wrap" />

        <DataGrid Grid.Row="1" x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="{StaticResource Line}"
                  Background="{StaticResource PanelBg}" BorderThickness="1"
                  BorderBrush="{StaticResource Line}" RowHeight="28" FontSize="13">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ชื่อ" Binding="{Binding Name}" Width="160" />
                <DataGridTextColumn Header="โดเมนที่รับ" Binding="{Binding Domains}" Width="*" />
                <DataGridTextColumn Header="รุ่น" Binding="{Binding Version}" Width="50" />
                <DataGridTextColumn Header="มาจาก" Binding="{Binding Source}" Width="110" />
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="2" x:Name="ErrorPanel" Margin="0,10,0,0" Padding="10"
                Background="#FFF4F4" BorderBrush="{StaticResource Danger}" BorderThickness="1"
                CornerRadius="4" Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="ไฟล์ที่โหลดไม่ขึ้น" FontWeight="SemiBold"
                           Foreground="{StaticResource Danger}" Margin="0,0,0,4" />
                <ItemsControl x:Name="ErrorList" FontSize="12">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,2" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="เปิดโฟลเดอร์ config" Width="150" Height="30" Margin="0,0,8,0"
                    Click="OnOpenFolder" />
            <Button Content="ปิด" Width="90" Height="30" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
