<Window x:Class="NewKewi.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NewKewi.App"
        Title="New Kewi Video Downloader"
        Icon="Resources/app.ico"
        Height="640" Width="1080" MinHeight="420" MinWidth="860"
        Background="{StaticResource WindowBg}"
        FontFamily="Segoe UI, Leelawadee UI"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <local:ByteSizeConverter x:Key="Size" />
        <local:SpeedConverter x:Key="Speed" />
        <local:EtaConverter x:Key="Eta" />
        <local:PercentConverter x:Key="Percent" />
        <local:StatusTextConverter x:Key="StatusText" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- แถบเครื่องมือแบบ IDM: ไอคอนใหญ่ ป้ายชื่อใต้ไอคอน -->
        <Border Grid.Row="0" Background="{StaticResource PanelBg}"
                BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="8,6">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource ToolButton}" Click="OnAddUrl">
                    <StackPanel>
                        <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE710;" />
                        <TextBlock Style="{StaticResource ToolLabel}" Text="เพิ่มลิงก์" />
                    </StackPanel>
                </Button>
                <Button x:Name="StartButton" Style="{StaticResource ToolButton}" Click="OnStart">
                    <StackPanel>
                        <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE768;" />
                        <TextBlock Style="{StaticResource ToolLabel}" Text="เริ่ม" />
                    </StackPanel>
                </Button>
                <Button x:Name="StopButton" Style="{StaticResource ToolButton}" Click="OnStop">
                    <StackPanel>
                        <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE769;" />
                        <TextBlock Style="{StaticResource ToolLabel}" Text="หยุด" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" Click="OnRetry">
                    <StackPanel>
                        <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE72C;" />
                        <TextBlock Style="{StaticResource ToolLabel}" Text="ลองใหม่" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" Click="OnRemove">
                    <StackPanel>
                        <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE74D;" />
                        <TextBlock Style="{StaticResource ToolLabel}" Text="ลบ" />
                    </StackPanel>
                </Button>

                <Rectangle Width="1" Margin="8,4" Fill="{StaticResource Line}" />

                <Button Style="{StaticResource ToolButton}" Click="OnOpenFolder">
                    <StackPanel>
                        <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE838;" />
                        <TextBlock Style="{StaticResource ToolLabel}" Text="เปิดโฟลเดอร์" />
                    </StackPanel>
                </Button>
                <Button x:Name="BotWallButton" Style="{StaticResource ToolButton}" Click="OnPassBotWall">
                    <StackPanel>
                        <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE72E;" />
                        <TextBlock Style="{StaticResource ToolLabel}" Text="ผ่านด่านเว็บ" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" Click="OnShowSites">
                    <StackPanel>
                        <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE7B3;" />
                        <TextBlock Style="{StaticResource ToolLabel}" Text="เว็บที่รองรับ" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" Click="OnOpenSettings">
                    <StackPanel>
                        <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE713;" />
                        <TextBlock Style="{StaticResource ToolLabel}" Text="ตั้งค่า" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" MinWidth="130" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource PanelBg}"
                    BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
                <ListBox x:Name="Categories" BorderThickness="0" Background="Transparent"
                         Margin="6,10" SelectedIndex="0" FontSize="13"
                         SelectionChanged="OnCategoryChanged">
                    <ListBoxItem Content="ทั้งหมด" Tag="all" />
                    <ListBoxItem Content="กำลังโหลด" Tag="active" />
                    <ListBoxItem Content="รอคิว" Tag="queued" />
                    <ListBoxItem Content="เสร็จแล้ว" Tag="done" />
                    <ListBoxItem Content="ล้มเหลว" Tag="failed" />
                </ListBox>
            </Border>

            <DataGrid x:Name="QueueGrid" Grid.Column="1"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{StaticResource Line}"
                      Background="{StaticResource PanelBg}" BorderThickness="0"
                      RowHeight="32" FontSize="13"
                      SelectionMode="Extended"
                      MouseDoubleClick="OnRowDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ชื่อไฟล์" Width="*"
                                        Binding="{Binding Title}" />
                    <DataGridTextColumn Header="ขนาด" Width="90"
                                        Binding="{Binding TotalBytes, Converter={StaticResource Size}}" />
                    <DataGridTextColumn Header="สถานะ" Width="130"
                                        Binding="{Binding Status, Converter={StaticResource StatusText}}" />

                    <DataGridTemplateColumn Header="คืบหน้า" Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid VerticalAlignment="Center" Margin="2,0">
                                    <ProgressBar Height="14" Minimum="0" Maximum="100"
                                                 Value="{Binding Progress, Mode=OneWay}"
                                                 Foreground="{StaticResource Accent}"
                                                 Background="{StaticResource AccentDim}"
                                                 BorderThickness="0" />
                                    <TextBlock FontSize="10" HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Text="{Binding Progress, Converter={StaticResource Percent}}" />
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="ความเร็ว" Width="100"
                                        Binding="{Binding SpeedBytesPerSecond, Converter={StaticResource Speed}}" />
                    <DataGridTextColumn Header="เหลืออีก" Width="85"
                                        Binding="{Binding EtaSeconds, Converter={StaticResource Eta}}" />
                    <DataGridTextColumn Header="หมายเหตุ" Width="220"
                                        Binding="{Binding FailureReason}"
                                        Foreground="{StaticResource Danger}" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource PanelBg}"
                BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="10,5">
            <TextBlock x:Name="StatusText" FontSize="12" Foreground="{StaticResource TextDim}" />
        </Border>
    </Grid>
</Window>
