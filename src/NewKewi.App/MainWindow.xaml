<Window x:Class="NewKewi.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New Kewi Video Downloader"
        Icon="Resources/app.ico"
        Height="640" Width="1060" MinHeight="420" MinWidth="820"
        Background="{StaticResource WindowBg}"
        FontFamily="Segoe UI, Leelawadee UI"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- แถบเครื่องมือแบบ IDM: ไอคอนใหญ่ ป้ายชื่อใต้ไอคอน -->
        <Border Grid.Row="0" Background="{StaticResource PanelBg}"
                BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="8,6">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource ToolButton}" Click="OnAddUrl">
                    <StackPanel>
                        <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE710;" />
                        <TextBlock Style="{StaticResource ToolLabel}" Text="เพิ่มลิงก์" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" IsEnabled="False">
                    <StackPanel>
                        <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE768;" />
                        <TextBlock Style="{StaticResource ToolLabel}" Text="เริ่ม" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" IsEnabled="False">
                    <StackPanel>
                        <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE769;" />
                        <TextBlock Style="{StaticResource ToolLabel}" Text="หยุด" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" IsEnabled="False">
                    <StackPanel>
                        <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE74D;" />
                        <TextBlock Style="{StaticResource ToolLabel}" Text="ลบ" />
                    </StackPanel>
                </Button>

                <Rectangle Width="1" Margin="8,4" Fill="{StaticResource Line}" />

                <Button Style="{StaticResource ToolButton}" IsEnabled="False">
                    <StackPanel>
                        <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE7B3;" />
                        <TextBlock Style="{StaticResource ToolLabel}" Text="เว็บที่รองรับ" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" IsEnabled="False">
                    <StackPanel>
                        <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE713;" />
                        <TextBlock Style="{StaticResource ToolLabel}" Text="ตั้งค่า" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- ซ้าย: หมวด · ขวา: ตารางคิว -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" MinWidth="130" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource PanelBg}"
                    BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
                <ListBox x:Name="Categories" BorderThickness="0" Background="Transparent"
                         Margin="6,10" SelectedIndex="0" FontSize="13">
                    <ListBoxItem Content="ทั้งหมด" />
                    <ListBoxItem Content="กำลังโหลด" />
                    <ListBoxItem Content="รอคิว" />
                    <ListBoxItem Content="เสร็จแล้ว" />
                    <ListBoxItem Content="ล้มเหลว" />
                </ListBox>
            </Border>

            <DataGrid x:Name="QueueGrid" Grid.Column="1"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{StaticResource Line}"
                      Background="{StaticResource PanelBg}" BorderThickness="0"
                      RowHeight="30" FontSize="13">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ชื่อไฟล์" Binding="{Binding Title}" Width="*" />
                    <DataGridTextColumn Header="ขนาด" Binding="{Binding Size}" Width="90" />
                    <DataGridTextColumn Header="สถานะ" Binding="{Binding Status}" Width="110" />
                    <DataGridTextColumn Header="คืบหน้า" Binding="{Binding Progress}" Width="80" />
                    <DataGridTextColumn Header="ความเร็ว" Binding="{Binding Speed}" Width="95" />
                    <DataGridTextColumn Header="เหลืออีก" Binding="{Binding Eta}" Width="85" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource PanelBg}"
                BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="10,5">
            <TextBlock x:Name="StatusText" FontSize="12" Foreground="{StaticResource TextDim}" />
        </Border>
    </Grid>
</Window>
