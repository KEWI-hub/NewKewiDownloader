<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- ใช้แค่ NotifyIcon ของ WinForms · WPF ไม่มีไอคอนถาดระบบในตัว -->
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>NewKewiDownloader</AssemblyName>
    <RootNamespace>NewKewi.App</RootNamespace>
    <!-- APP_VERSION — ต้องตรงกับ tag ที่จะ push เสมอ -->
    <Version>0.6.0</Version>
    <ApplicationIcon>..\..\assets\app.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!--
      เปิด UseWindowsForms แล้ว SDK จะใส่ using ของ System.Windows.Forms กับ System.Drawing ให้เอง
      ซึ่งไปชนกับของ WPF (Application, Brush, Color, Point…) เอาออกแล้วเรียกแบบเต็มชื่อใน TrayIcon แทน
    -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="..\..\assets\app.ico" Link="Resources\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NewKewi.Core\NewKewi.Core.csproj" />
    <ProjectReference Include="..\NewKewi.Sites\NewKewi.Sites.csproj" />
    <ProjectReference Include="..\NewKewi.Bridge\NewKewi.Bridge.csproj" />
  </ItemGroup>

</Project>
