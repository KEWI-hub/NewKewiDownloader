<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- สีหลักของแอป — ฟ้าเดียวกับวงแหวนโหลดในไอคอน -->
    <Color x:Key="AccentColor">#2997FF</Color>
    <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentDim" Color="#D6EAFF" />
    <SolidColorBrush x:Key="WindowBg" Color="#F7F8FA" />
    <SolidColorBrush x:Key="PanelBg" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Line" Color="#E2E5EA" />
    <SolidColorBrush x:Key="TextMain" Color="#1B1F24" />
    <SolidColorBrush x:Key="TextDim" Color="#6B7480" />
    <SolidColorBrush x:Key="Danger" Color="#D13438" />
    <SolidColorBrush x:Key="Ok" Color="#107C41" />

    <!-- ปุ่มบน toolbar: ไอคอนใหญ่ ตัวหนังสือเล็กใต้ไอคอน แบบ IDM -->
    <Style x:Key="ToolButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Margin" Value="2,0" />
        <Setter Property="Foreground" Value="{StaticResource TextMain}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentDim}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ToolGlyph" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{StaticResource Accent}" />
    </Style>

    <Style x:Key="ToolLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Margin" Value="0,3,0,0" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{StaticResource TextDim}" />
    </Style>

</ResourceDictionary>
