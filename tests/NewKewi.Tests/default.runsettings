<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <RunConfiguration>
    <!--
      ชุดปกติไม่รันเทสที่ยิงเน็ตจริง เพราะเน็ตช้าหรือเว็บล่มทำให้ fail แบบหลอกๆ
      จะรันของจริงให้สั่ง dotnet test พร้อมธง filter เป็น Category=live
    -->
    <TestCaseFilter>Category!=live</TestCaseFilter>
  </RunConfiguration>
</RunSettings>
